font=JetBrainsMono Nerd Font 11
background-color=#fffffff2
text-color=#3a3f4b
border-color=#c3cee6
border-size=1
border-radius=10
padding=12
margin=8
default-timeout=5000
max-visible=4
anchor=top-right
width=340
height=110
icons=1

[urgency=critical]
border-color=#d64760
default-timeout=0

[app-name=Screenshot actionable]
default-timeout=15000
on-button-left=invoke-default-action
on-button-middle=invoke-action copy
on-button-right=exec makoctl menu -n "$id" -- wofi --dmenu --prompt 'Screenshot'

[app-name=Screenrecord actionable]
default-timeout=15000
on-button-left=invoke-default-action
on-button-middle=invoke-action copy
on-button-right=exec makoctl menu -n "$id" -- wofi --dmenu --prompt 'Rekaman'
