{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    "modules-left": ["hyprland/workspaces", "hyprland/window"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "cpu", "temperature", "memory", "disk", "pulseaudio", "backlight", "network", "bluetooth", "battery"],

    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{id}",
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "gsimplecal",
        "on-click-right": "~/.local/bin/theme.sh toggle"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip-format": "CPU load {load}",
        "on-click": "kitty -e btop"
    },

    "temperature": {
        // Absolute device path (stable across boots, unlike hwmonN numbering);
        // temp1_input = coretemp "Package id 0" = the CPU package temperature.
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "format": "TEMP {temperatureC}°C",
        "format-critical": "TEMP {temperatureC}°C",
        "critical-threshold": 85,
        "interval": 2,
        "tooltip-format": "CPU package {temperatureC}°C",
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "RAM {percentage}%",
        "interval": 3,
        "tooltip-format": "RAM {used:0.1f}G / {total:0.1f}G   ·   Swap {swapUsed:0.1f}G",
        "on-click": "kitty -e btop"
    },

    "disk": {
        "format": "DISK {percentage_used}%",
        "path": "/",
        "interval": 30,
        "tooltip-format": "Storage {used} / {total} ({percentage_used}% used)",
        "on-click": "thunar"
    },

    "network": {
        "format-wifi": "WIFI {signalStrength}%",
        "format-ethernet": "LAN",
        "format-linked": "LAN",
        "format-disconnected": "NET off",
        "tooltip-format-wifi": "{essid} · {signalStrength}%",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected — right-click to toggle Wi-Fi",
        "on-click": "nm-connection-editor",
        "on-click-right": "~/.local/bin/toggle-wifi.sh"
    },

    "bluetooth": {
        "format": "BT",
        "format-off": "BT off",
        "format-disabled": "BT off",
        "format-connected": "BT {num_connections}",
        "tooltip-format": "{controller_alias}\n{status}\nright-click to toggle",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "on-click": "blueman-manager",
        "on-click-right": "~/.local/bin/toggle-bt.sh"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL mute",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "backlight": {
        "format": "BRT {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%",
        "format-plugged": "BAT {capacity}%",
        "tooltip-format": "{timeTo} · {power}W"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
