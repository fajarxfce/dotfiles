{
    "layer": "top",
    "position": "top",
    "height": 34,
    "spacing": 4,

    // System stats sit on the LEFT, right after the workspaces, fenced off by
    // hairline separators (see #custom-sep in the stylesheet).
    "modules-left": ["hyprland/workspaces", "custom/sep", "disk", "cpu", "temperature", "memory", "custom/sep2", "hyprland/window"],
    "modules-center": ["clock"],
    // Network status and live download/upload share one module. Bluetooth only
    // appears once a device is connected; the managers also live in the tray.
    "modules-right": ["tray", "pulseaudio", "backlight", "network", "bluetooth", "battery"],

    // A blank label; the visible hairline is the CSS border-left.
    "custom/sep":  { "format": " ", "tooltip": false },
    "custom/sep2": { "format": " ", "tooltip": false },

    "hyprland/workspaces": {
        "on-click": "activate",
        "format": "{id}",
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/window": {
        "max-length": 40,
        "separate-outputs": true
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "on-click": "gsimplecal",
        "on-click-right": "~/.local/bin/theme.sh toggle"
    },

    "disk": {
        "format": "DISK {percentage_used}%",
        "path": "/",
        "interval": 30,
        "tooltip-format": "Storage {used} / {total} ({percentage_used}% used)",
        "on-click": "thunar"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 2,
        "tooltip-format": "CPU load {load}",
        "on-click": "alacritty -e btop"
    },

    "temperature": {
        // Absolute device path (stable across boots, unlike hwmonN numbering);
        // temp1_input = coretemp "Package id 0" = the CPU package temperature.
        "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
        "input-filename": "temp1_input",
        "format": "TEMP {temperatureC}°C",
        "format-critical": "TEMP {temperatureC}°C",
        "critical-threshold": 85,
        "interval": 2,
        "tooltip-format": "CPU package {temperatureC}°C",
        "on-click": "alacritty -e btop"
    },

    "memory": {
        "format": "RAM {percentage}%",
        "interval": 3,
        "tooltip-format": "RAM {used:0.1f}G / {total:0.1f}G   ·   Swap {swapUsed:0.1f}G",
        "on-click": "alacritty -e btop"
    },

    "network": {
        // Keep download/upload visible; bandwidth*Bytes already includes /s.
        "interval": 2,
        "format-wifi": "WIFI {signalStrength}%  ↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "format-ethernet": "LAN  ↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "format-linked": "LAN  ↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "format-disconnected": "NET off",
        "tooltip-format-wifi": "{essid} · {signalStrength}%\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n↓ {bandwidthDownBytes}   ↑ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Disconnected — right-click to toggle Wi-Fi",
        "on-click": "nm-connection-editor",
        "on-click-right": "~/.local/bin/toggle-wifi.sh"
    },

    "bluetooth": {
        // Empty format = waybar hides the module. Off/on-but-idle is already
        // visible via the blueman tray icon, so only show a connected count.
        "format": "",
        "format-off": "",
        "format-disabled": "",
        "format-connected": "BT {num_connections}",
        "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
        "on-click": "blueman-manager",
        "on-click-right": "~/.local/bin/toggle-bt.sh"
    },

    "pulseaudio": {
        "format": "VOL {volume}%",
        "format-muted": "VOL mute",
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },

    "backlight": {
        "format": "BRT {percent}%",
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-"
    },

    "battery": {
        "states": { "warning": 30, "critical": 15 },
        "format": "BAT {capacity}%",
        "format-charging": "CHG {capacity}%",
        "format-plugged": "BAT {capacity}%",
        "tooltip-format": "{timeTo} · {power}W"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 8
    }
}
